{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>simonerigoni/github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "torch",
        "torchvision"
      ],
      "groupName": "pytorch",
      "allowedVersions": "/^[0-9]+(\\.[0-9]+)*$/"
    }
  ]
}
